Cell["Ejercicio 4.1", "Section",
 CellChangeTimes->{{3.9845498698889484`*^9, 3.984549873031191*^9}, {
  3.985758689977703*^9, 
  3.9857586902281513`*^9}},ExpressionUUID->"af565622-a3f5-c24e-8d27-\
ee06f14edd23"],

Cell[TextData[{
 "Diferenciamos tres casos \[OpenCurlyDoubleQuote]interesantes\
\[CloseCurlyDoubleQuote]: si ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], ">", "1"}], TraditionalForm], "errors" -> {}, 
     "input" -> "a > 1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f4bc9701-7eb3-0648-bf27-41c30463d000"],
 ", diverge, si ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-1", "<", 
         StyleBox["a", "TI"], "<", "0"}], TraditionalForm], "errors" -> {}, 
     "input" -> "-1 < a < 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d2de9605-dbf8-554a-9f51-72fde064e0ad"],
 " converge a 0 oscilando y si ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[LongEqual]", "-1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "a = -1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a63127b9-5956-0243-bb90-ab313516a694"],
 " oscila entre -1 y 1. Se observan los tres casos en la gr\[AAcute]fica."
}], "Text",
 CellChangeTimes->{{3.9857595367842293`*^9, 
  3.985759630908497*^9}},ExpressionUUID->"4c72b2c8-cc17-9045-8e32-\
eb6cfcc80b9d"],

