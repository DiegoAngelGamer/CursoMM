Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"datos", "=", 
    RowBox[{"ParallelTable", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"f", "=", 
        RowBox[{
         RowBox[{"#", " ", 
          RowBox[{"(", 
           RowBox[{"r", " ", 
            RowBox[{"(", 
             RowBox[{"1", "-", "#"}], ")"}]}], ")"}]}], "&"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"listapuntos", "=", 
        RowBox[{"NestList", "[", 
         RowBox[{"f", ",", "0.5", ",", "500"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Thread", "[", 
        RowBox[{"{", 
         RowBox[{"r", ",", 
          RowBox[{"Drop", "[", 
           RowBox[{"listapuntos", ",", "100"}], "]"}]}], "}"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "3", ",", "4", ",", "0.001"}], "}"}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"Flatten", "[", 
    RowBox[{"datos", ",", "1"}], "]"}], ",", 
