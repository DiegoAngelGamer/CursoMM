Cell[TextData[{
 "Vemos que ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["F", "TI"], 
         RowBox[{"(", 
           OverscriptBox[
            SubscriptBox[
             StyleBox["x", "TI"], "3"], "_"], ")"}], "\[LongEqual]", 
         OverscriptBox[
          SubscriptBox[
           StyleBox["x", "TI"], "4"], "_"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "F(\\bar{x_3}) = \\bar{x_4}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9d28b02c-3e9b-d546-95bc-0aef20360942"],
 " y viceversa."
}], "Text",
 CellChangeTimes->{{3.98628009405715*^9, 3.9862801070121098`*^9}, {
