Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"p2", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"c", "/", "d"}], ",", 
     RowBox[{"a", "/", "b"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"y", "^", "a"}], ")"}], "*", 
   RowBox[{"(", 
    RowBox[{"x", "^", "c"}], ")"}], "*", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "d"}], "*", "x"}], "-", 
     RowBox[{"b", "*", "y"}]}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"ContourPlot", "[", 
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x", ",", "y"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0.1", ",", "15"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", "0.1", ",", "10"}], "}"}], ",", 
   RowBox[{"Contours", "->", "10"}], ",", 
   RowBox[{"ContourShading", "->", "None"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Presas (x)\>\"", ",", "\"\<Depredadores (y)\>\""}], "}"}]}],
    ",", 
   RowBox[{"Epilog", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"PointSize", "[", "Large", "]"}], ",", 
      RowBox[{"Point", "[", "p2", "]"}], ",", 
      RowBox[{"Text", "[", 
       RowBox[{"\"\<P2\>\"", ",", "p2", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1.5"}], ",", 
          RowBox[{"-", "1.5"}]}], "}"}]}], "]"}]}], "}"}]}]}], 
  "]"}], "\n"}], "Input",
