Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"eq1", ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"x", "'"}], "[", "t", "]"}], " ", "==", " ", 
    RowBox[{
     RowBox[{"a", " ", 
      RowBox[{"x", "[", "t", "]"}]}], " ", "-", " ", 
     RowBox[{"b", " ", 
      RowBox[{"x", "[", "t", "]"}], " ", 
      RowBox[{"y", "[", "t", "]"}]}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eq2", ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "c"}], " ", 
      RowBox[{"y", "[", "t", "]"}]}], "  ", "+", " ", 
     RowBox[{"d", " ", 
      RowBox[{"x", "[", "t", "]"}], " ", 
      RowBox[{"y", "[", "t", "]"}]}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ci", " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"x", "[", "0", "]"}], "==", "10"}], ",", 
    RowBox[{
     RowBox[{"y", "[", "0", "]"}], "==", "5"}]}], "}"}]}]}], "Input",
