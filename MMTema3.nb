Cell[CellGroupData[{

Cell["Ejercicio 3.4", "Section",
 CellChangeTimes->{{3.9845519872430897`*^9, 3.9845519891408367`*^9}, {
  3.984635894258362*^9, 
  3.9846358943736916`*^9}},ExpressionUUID->"fd020e8c-84fa-9844-ae63-\
364a8035a7cc"],

Cell[TextData[{
 "Al resolver la ecuaci\[OAcute]n por variables separadas, obtenemos la funci\
\[OAcute]n log\[IAcute]stica:\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["x", "TI"], 
         RowBox[{"(", 
           StyleBox["t", "TI"], ")"}], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            StyleBox["K", "TI"], "\[CenterDot]", 
            SubscriptBox[
             StyleBox["x", "TI"], "0"], "\[CenterDot]", 
            SuperscriptBox[
             StyleBox["e", "TI"], 
             RowBox[{
               StyleBox["a", "TI"], 
               StyleBox["t", "TI"]}]]}], 
          RowBox[{
            StyleBox["K", "TI"], "+", 
            SubscriptBox[
             StyleBox["x", "TI"], "0"], 
            RowBox[{"(", 
              RowBox[{
                SuperscriptBox[
                 StyleBox["e", "TI"], 
                 RowBox[{
                   StyleBox["a", "TI"], 
                   StyleBox["t", "TI"]}]], "-", "1"}], ")"}]}]]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "x(t) = \\frac{K \\cdot x_0 \\cdot e^{at}}{K + x_0(e^{at} -1)}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7b67d844-2fe8-3147-a635-941483568599"]
}], "Text",
 CellChangeTimes->{{3.9845509798343353`*^9, 3.98455102508638*^9}, {
   3.9845511665718975`*^9, 3.98455116904583*^9}, {3.984551255443033*^9, 
   3.9845513147029305`*^9}, 3.9845522623021545`*^9, {3.984635756569847*^9, 
   3.9846357830950985`*^9}, {3.9846358970719337`*^9, 3.984635921813879*^9}, 
   3.9846361182987576`*^9},ExpressionUUID->"a038b903-671c-c84f-897e-\
0610dce2ab0b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Definimos", " ", "la", " ", "soluci\[OAcute]n", " ", 
    "anal\[IAcute]tica"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"solucionLogistica", "[", 
     RowBox[{"t_", ",", "a_", ",", "K_", ",", "x0_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"K", "*", "x0", "*", 
       RowBox[{"Exp", "[", 
        RowBox[{"a", "*", "t"}], "]"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"K", "+", 
       RowBox[{"x0", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"a", "*", "t"}], "]"}], "-", "1"}], ")"}]}]}], ")"}]}]}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"Manipulate", "[", 
    RowBox[{
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"solucionLogistica", "[", 
        RowBox[{"t", ",", "a", ",", "K", ",", "x0"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "20"}], "}"}], ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"K", "*", "1.1"}]}], "}"}]}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Thick", ",", "Blue"}], "}"}]}], ",", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<t\>\"", ",", "\"\<x(t)\>\""}], "}"}]}], ",", 
       RowBox[{"PlotLabel", "->", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<Curva Sigmoide Log\[IAcute]stica\>\"", ",", "Bold", ",",
           "14"}], "]"}]}], ",", 
       RowBox[{"Filling", "->", "Axis"}]}], "]"}], ",", "\[IndentingNewLine]",
      "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "a", ",", "0.5", ",", "\"\<Tasa de reproducci\[OAcute]n (a)\>\""}], 
        "}"}], ",", "0.1", ",", "2", ",", 
       RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"K", ",", "50", ",", "\"\<Soporte del medio (K)\>\""}], "}"}],
        ",", "10", ",", "100", ",", 
       RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "x0", ",", "2", ",", "\"\<Poblaci\[OAcute]n inicial (x0)\>\""}], 
        "}"}], ",", "0.1", ",", "20", ",", 
       RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9846361513498116`*^9, 3.984636156362377*^9}, {
  3.984636189532387*^9, 3.984636199504793*^9}, {3.9846362479609966`*^9, 
  3.984636260548212*^9}},
 CellLabel->"In[27]:=",ExpressionUUID->"473bdc26-0435-c94d-a16f-4c5fcd7b642b"],

