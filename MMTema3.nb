Cell[CellGroupData[{

Cell["Modelo Compensatorio", "Subsection",
 CellChangeTimes->{{3.9854141604582577`*^9, 
  3.985414292363537*^9}},ExpressionUUID->"e0a1ff1c-6ede-c54f-8971-\
9bbd5d7013d5"],

Cell[TextData[{
 "Puntos de equilibrio: Tiene dos puntos de equilibrio: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["x", "TI"], "1"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "x_1 = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f9bb4e1c-77ff-d742-9719-bc9488abe4a6"],
 " y ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["x", "TI"], "2"], ">", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "x_2>0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "66f85abc-040b-9a41-a490-48014144634a"],
 ".\nEstabilidad: El punto ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["x", "TI"], "1"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "x_1 = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a863512e-564f-174e-8218-e953eb65e402"],
 " es inestable, mientras que ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["x", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "x_2 ", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2b7e22e4-76c9-1848-8f0b-fbeed201332e"],
 " es asint\[OAcute]ticamente estable.\nForma de la curva: Es \
cualitativamente similar al modelo log\[IAcute]stico. La poblaci\[OAcute]n \
siempre tiende al valor estable ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["x", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "x_2 ", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bb416c2f-dbb5-3c49-b2ff-0bc466ab05c2"],
 " siempre que la poblaci\[OAcute]n inicial sea mayor que cero (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["x", "TI"], "0"], ">", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "x_0>0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f1c6e9ba-2faa-b545-adb8-c52a559447e6"],
 ")."
}], "Text",
 CellChangeTimes->{{3.9854142998236694`*^9, 
  3.9854143056686344`*^9}},ExpressionUUID->"c7f5553a-a7a9-7544-bfb7-\
a2fdfb6bf7cb"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Modelo Despensatorio", "Subsection",
 CellChangeTimes->{{3.9854143578875427`*^9, 
  3.985414366280449*^9}},ExpressionUUID->"8bfd1df4-8109-2f4b-b71c-\
e0cca935fde7"],

Cell[TextData[{
 "Puntos de equilibrio: Al igual que el compensatorio, tiene dos puntos de \
equilibrio (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["x", "TI"], "1"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "x_1 =0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0deaed9a-39b7-394c-baa4-a250d9f2a5ca"],
 " inestable y ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["x", "TI"], "2"], ">", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "x_2>0 ", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "88f1d8f2-5876-024e-aa8a-eb16b62a6b8c"],
 " estable).\nForma de la curva (Efecto Allee): Su diferencia \
matem\[AAcute]tica principal es que la curva de crecimiento es convexa para \
valores peque\[NTilde]os de poblaci\[OAcute]n.\nEsto indica un crecimiento \
muy lento al principio hasta alcanzar un punto de inflexi\[OAcute]n, a partir \
del cual la curva se vuelve c\[OAcute]ncava y el crecimiento es m\[AAcute]s r\
\[AAcute]pido.\nComportamiento: Aunque el crecimiento inicial es lento, la \
poblaci\[OAcute]n sigue tendiendo a estabilizarse en",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    TemplateBox[<|"boxes" -> FormBox[
        SubscriptBox[
         StyleBox["x", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
      " x_2", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"]}], TraditionalForm]],ExpressionUUID->
  "91572e54-f06d-6e4f-a58d-5d1120bcb6d5"],
 "."
}], "Text",
 CellChangeTimes->{{3.985414372691288*^9, 
  3.98541443876614*^9}},ExpressionUUID->"6e9fd2bd-4925-4c4c-86a1-\
c5bcaa0fdf86"]
}, Open  ]],

