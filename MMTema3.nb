      RowBox[{"Style", "[", 
       RowBox[{
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          
          RowBox[{"\"\<Diagrama de bifurcaci\[OAcute]n plano (q = \>\"", ",", 
           "q", ",", "\"\<)\>\""}], "}"}], "]"}], ",", "12"}], "]"}]}], ",", 
     RowBox[{"ContourStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Blue", ",", 
        RowBox[{"Thickness", "[", "0.005", "]"}]}], "}"}]}], ",", 
     RowBox[{"GridLines", "->", "Automatic"}], ",", 
     RowBox[{"PlotPoints", "->", "60"}], ",", 
     RowBox[{"Exclusions", "->", "None"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"q", ",", "10", ",", "\"\<Par\[AAcute]metro q\>\""}], "}"}], ",",
      "2", ",", "20", ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}]}], 
  "]"}]], "Input",
