      RowBox[{"Style", "[", 
       RowBox[{"\"\<Modelo de Ludwig\>\"", ",", "Bold", ",", "14"}], "]"}]}], 
     ",", 
     RowBox[{"Filling", "->", "Axis"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
