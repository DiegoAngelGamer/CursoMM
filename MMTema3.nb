RowBox[{\\\"e\\\", \\\"/.\\\", \\\"\[VeryThinSpace]\\\", \
RowBox[{RowBox[{\\\"{\\\", RowBox[{\\\"{\\\", RowBox[{RowBox[{\\\"x\\\", \\\"\
\[Rule]\\\", \\\"5.000000000000002`\\\"}], \\\",\\\", RowBox[{\\\"e\\\", \\\"\
\[Rule]\\\", \\\"0.12500000000000003`\\\"}]}], \\\"}\\\"}], \\\"}\\\"}], \\\"\
\[LeftDoubleBracket]\\\", \\\"4\\\", \\\"\[RightDoubleBracket]\\\"}]}], \\\")\
\\\"}]}]}], \\\"}\\\"}]\\) is not a machine-sized real number.\"", 2, 61, 5, 
   27963933093116332283, "Local"},
