            RowBox[{"f", "[", "x", "]"}], "==", 
            RowBox[{"e", "*", "x"}]}], "&&", 
           RowBox[{"x", ">", "2"}]}], ",", "x"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"xeq", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"sols", "==", 
          RowBox[{"{", "}"}]}], ",", "0", ",", 
         RowBox[{"Max", "[", "sols", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"b", "=", 
       RowBox[{"e", "*", "xeq"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"GraphicsRow", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Plot", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"f", "[", "x", "]"}], ",", 
              RowBox[{"h", "[", "x", "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "0", ",", "12"}], "}"}], ",", 
            RowBox[{"PlotRange", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "0.5"}], ",", "1"}], "}"}]}], ",", 
            RowBox[{"AxesLabel", "->", 
             RowBox[{"{", 
              RowBox[{"\"\<x\>\"", ",", "\"\<F(x)\>\""}], "}"}]}], ",", 
            RowBox[{"Epilog", "->", 
             RowBox[{"{", 
              RowBox[{"Red", ",", 
               RowBox[{"PointSize", "[", "Large", "]"}], ",", 
