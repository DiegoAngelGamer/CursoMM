                RowBox[{"{", 
                 RowBox[{"xeq", ",", 
                  RowBox[{"e", "*", "xeq"}]}], "}"}], "]"}]}], "}"}]}]}], 
           "]"}], ",", 
          RowBox[{"Plot", "[", 
           RowBox[{
            RowBox[{"ee", "*", 
             RowBox[{"Max", "[", 
              RowBox[{"0", ",", 
               RowBox[{
                RowBox[{"x", "/.", " ", 
                 RowBox[{"NSolve", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"f", "[", "x", "]"}], "==", 
                    RowBox[{"ee", "*", "x"}]}], "&&", 
                    RowBox[{"x", ">", "2"}]}], ",", "x"}], "]"}]}], "/.", " ", 
                RowBox[{
                 RowBox[{"{", "}"}], "->", 
                 RowBox[{"{", "0", "}"}]}]}]}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"ee", ",", "0", ",", "0.15"}], "}"}], ",", 
            RowBox[{"AxesLabel", "->", 
             RowBox[{"{", 
              RowBox[{"\"\<e\>\"", ",", "\"\<B\>\""}], "}"}]}], ",", 
