   RowBox[{"3", "*", 
    RowBox[{"Sqrt", "[", "4", "]"}]}]}], ";"}], "\n", 
 RowBox[{"ContourPlot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"s", "*", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"u", "/", "qcrit"}]}], ")"}]}], "==", 
    RowBox[{"u", "/", 
     RowBox[{"(", 
