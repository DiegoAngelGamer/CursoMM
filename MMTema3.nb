Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"x", "[", "t", "]"}], "\[Rule]", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"a", " ", "t"}], "-", 
       RowBox[{"b", " ", "t"}]}]], " ", "x0"}]}], "}"}], "}"}]], "Output",
