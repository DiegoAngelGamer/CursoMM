Cell[CellGroupData[{

Cell["Ejercicio 3.2", "Section",
 CellChangeTimes->{{3.9845506602506886`*^9, 
  3.984550662397421*^9}},ExpressionUUID->"b4bf6a27-ec4a-964f-9833-\
6f9e59f9cb82"],

Cell[TextData[{
 "Evaluamos nuestra ecuaci\[OAcute]n diferencial de variable temporal t y \
concentraci\[OAcute]n de pobla\.08ci\[OAcute]n x(t) dentro de un Plot, con \
argumentos PlotRange, PlotLabel y AxesLabel para embellecerlo un poco. \
Mediante la funci\[OAcute]n Manipulate, podemos modificar ambos \
par\[AAcute]metros a y b, como el valor inicial del PVI para t = 0. Se \
observa entonces que, si a < b, la poblaci\[OAcute]n decrece y se extingue; \
si a = b, ser\[AAcute] valor constante ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["x", "TI"], "0"], TraditionalForm], "errors" -> {}, "input" -> 
     "x_0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bb092c1c-d9c7-4940-9530-dfc815316497"],
 ", y si a > b la poblaci\[OAcute]n crece hasta diverger."
}], "Text",
 CellChangeTimes->{{3.984550678498663*^9, 3.98455095974032*^9}, {
  3.9845511303669586`*^9, 3.984551152198122*^9}, {3.984552275091196*^9, 
  3.984552301809431*^9}},ExpressionUUID->"0b541962-c75e-a44e-a034-\
b13abda340b4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{"x", "[", "t", "]"}], "/.", " ", 
       RowBox[{"DSolve", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"x", "'"}], "[", "t", "]"}], "==", 
           RowBox[{
            RowBox[{"a", " ", 
             RowBox[{"x", "[", "t", "]"}]}], "-", 
            RowBox[{"b", " ", 
             RowBox[{"x", "[", "t", "]"}]}]}]}], ",", 
          RowBox[{
           RowBox[{"x", "[", "0", "]"}], "==", "x0"}]}], "}"}], "]"}]}], 
      "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "10"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{"0", ",", "10"}], "}"}]}], ",", 
     RowBox[{"PlotLabel", "->", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<Soluci\[OAcute]n para a = \>\"", ",", " ", "a", ",", 
         " ", "\"\< y b = \>\"", ",", " ", "b"}], "}"}], "]"}]}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<t\>\"", ",", "\"\<x(t)\>\""}], "}"}]}], ",", 
     RowBox[{"Filling", "->", "Axis"}]}], "]"}], ",", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "1", ",", "\"\<a\>\""}], "}"}], ",", "0", ",", "5", ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"b", ",", "0.5", ",", "\"\<b\>\""}], "}"}], ",", "0", ",", "5", 
     ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x0", ",", "1", ",", "\"\<x0\>\""}], "}"}], ",", "0", ",", "10",
      ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.9845501342065544`*^9, 3.984550151356367*^9}, {
