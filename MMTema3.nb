Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"q1", " ", "=", " ", "3"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"Un", " ", "valor", " ", "menor", " ", "que", " ", "5.196"}], " ", 
   "*)"}]}], "\n", 
 RowBox[{"ContourPlot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"s", "*", 
     RowBox[{"(", 
      RowBox[{"1", " ", "-", " ", 
       RowBox[{"u", "/", "q1"}]}], ")"}]}], " ", "==", " ", 
    RowBox[{"u", "/", 
     RowBox[{"(", 
      RowBox[{"1", " ", "+", " ", 
       RowBox[{"u", "^", "2"}]}], ")"}]}]}], ",", " ", 
   RowBox[{"{", 
