   3.9845522623021545`*^9},ExpressionUUID->"c3ed85a1-ff73-4d4a-ad46-\
aca6782950ef"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DSolve", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"x", "'"}], "[", "t", "]"}], "==", 
     RowBox[{
      RowBox[{"a", " ", 
       RowBox[{"x", "[", "t", "]"}]}], "-", 
      RowBox[{"b", " ", 
       RowBox[{"x", "[", "t", "]"}]}]}]}], ",", 
    RowBox[{
     RowBox[{"x", "[", "0", "]"}], "==", "x0"}]}], "}"}], "]"}]], "Input",
 CellChangeTimes->{
  3.9845509842946568`*^9, {3.9845512638523293`*^9, 3.984551264833927*^9}, {
