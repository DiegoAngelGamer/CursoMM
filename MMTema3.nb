Cell[BoxData[{
 RowBox[{
  RowBox[{"qParam", "[", "c_", "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"2", " ", 
     RowBox[{"c", "^", "3"}]}], ")"}], "/", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"c", "^", "2"}], "-", "1"}], ")"}]}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sParam", "[", "c_", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"2", " ", 
      RowBox[{"c", "^", "3"}]}], ")"}], "/", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"c", "^", "2"}]}], ")"}], "^", "2"}]}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "1.", " ", "Buscamos", " ", "los", " ", "valores", " ", "de", " ", "c", " ",
      "para", " ", "q"}], "=", "7"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"cSol", "=", 
    RowBox[{"NSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"qParam", "[", "c", "]"}], "==", "7"}], ",", 
        RowBox[{"c", ">", "1"}]}], "}"}], ",", "c"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "2.", " ", "Calculamos", " ", "los", " ", "valores", " ", 
    "cr\[IAcute]ticos", " ", "de", " ", "s", " ", "para", " ", "esos", " ", 
    "c"}], "*)"}]}], "\n", 
 RowBox[{"sCriticos", "=", 
  RowBox[{
   RowBox[{"sParam", "[", "c", "]"}], "/.", " ", "cSol"}]}], "\n", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Salen", " ", "s1"}], "\[TildeTilde]", 
    RowBox[{"0.513", " ", "y", " ", "s2"}], "\[TildeTilde]", "0.601"}], 
   "*)"}]}]}], "Input",
