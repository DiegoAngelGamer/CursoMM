Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"ContourPlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"s", "*", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"u", "/", "q"}]}], ")"}]}], "-", 
       RowBox[{"u", "/", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"u", "^", "2"}]}], ")"}]}]}], "==", "0"}], ",", 
     RowBox[{"{", 
      RowBox[{"s", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
