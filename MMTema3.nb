     "x_2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5d142ec0-6bf5-e640-a147-e7f0e788c163"],
 " y ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["x", "TI"], "3"], TraditionalForm], "errors" -> {}, "input" -> 
     "x_3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "68e6a77f-2cd2-c344-9aa2-94a525a6d06e"],
 ".\nEstabilidad: A diferencia de los anteriores, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["x", "TI"], "1"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "x_1=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f509ca46-ae5d-5e4d-9bff-bf4181c517df"],
 " es asint\[OAcute]ticamente estable.\nEl punto intermedio ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["x", "TI"], "3"], TraditionalForm], "errors" -> {}, "input" -> 
     "x_3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e543f08a-9361-6c41-bdf8-67de93403bed"],
 " es inestable y el punto superior ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["x", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "x_2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e1af3704-3884-9b4c-b375-6fcdf73feda4"],
 " es asint\[OAcute]ticamente estable.\nTasa de crecimiento: Para \
concentraciones peque\[NTilde]as de poblaci\[OAcute]n, la tasa de crecimiento \
es negativa (la mortalidad supera a la reproducci\[OAcute]n).\nUmbral de \
extinci\[OAcute]n: El punto inestable ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["x", "TI"], "3"], TraditionalForm], "errors" -> {}, "input" -> 
     "x_3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "46c68d75-c0a8-2d4a-9ff2-936d96265f90"],
 " act\[UAcute]a como un umbral cr\[IAcute]tico; si la poblaci\[OAcute]n \
inicial ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["x", "TI"], "0"], TraditionalForm], "errors" -> {}, "input" -> 
     "x_0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "acbbc7da-ddd5-6f49-bd04-452db9cb53be"],
 " es inferior a ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["x", "TI"], "3"], TraditionalForm], "errors" -> {}, "input" -> 
     "x_3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0e9b224c-852a-8441-ac55-1779496d435c"],
 ", la especie se extingue inevitablemente. Si es superior, se estabiliza en ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["x", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "x_2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "85f2ff0d-aad2-9940-ad0a-f01c76183e96"],
 "."
}], "Text",
 CellChangeTimes->{{3.9854144737076187`*^9, 
  3.985414612227249*^9}},ExpressionUUID->"e6511907-fc7c-6a4d-944a-\
257c1a55cc0a"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Ejercicio 3.6", "Section",
 CellChangeTimes->{{3.9845519872430897`*^9, 3.9845519891408367`*^9}, {
  3.984635894258362*^9, 3.9846358943736916`*^9}, {3.985068578544052*^9, 
  3.985068579519459*^9}, {3.9850822537476635`*^9, 
  3.9850822541760025`*^9}},ExpressionUUID->"516cdcf9-10ec-924d-90d1-\
e780c28f1959"],

Cell[CellGroupData[{

Cell["Modelo Compensatorio", "Subsection",
 CellChangeTimes->{{3.9854141604582577`*^9, 
  3.985414292363537*^9}},ExpressionUUID->"d2e3bfea-e510-1346-a010-\
209c3c596890"],

Cell["He usado una versi\[OAcute]n sencilla del modelo log\[IAcute]stico:", \
"Text",
 CellChangeTimes->{{3.9854142998236694`*^9, 3.9854143056686344`*^9}, {
  3.987083077785471*^9, 
  3.987083086910452*^9}},ExpressionUUID->"b98f9944-7190-9b49-b945-\
b727a05471a2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"r", "=", "0.5"}], ";", 
  RowBox[{"K", "=", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Fcomp", "[", "x_", "]"}], ":=", 
    RowBox[{"r", "*", "x", "*", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"x", "/", "K"}]}], ")"}]}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Puntos", " ", "de", " ", "equilibrio"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"equilibriosComp", "=", 
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Fcomp", "[", "x", "]"}], "==", "0"}], ",", "x"}], "]"}]}], 
  "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Estabilidad", ":", 
    RowBox[{
    "evaluamos", " ", "la", " ", "derivada", " ", "en", " ", "los", " ", 
     "equilibrios"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"derComp", "=", 
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"Fcomp", "[", "x", "]"}], ",", "x"}], "]"}]}], ";"}], "\n", 
 RowBox[{"derComp", "/.", " ", "equilibriosComp"}], "\n", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Resultado", ":", 
      RowBox[{
       RowBox[{"F", "'"}], 
       RowBox[{"(", "0", ")"}]}]}], "=", 
     RowBox[{"0.5", ">", 
      RowBox[{"0", " ", 
       RowBox[{"(", "inestable", ")"}]}]}]}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"F", "'"}], 
      RowBox[{"(", "10", ")"}]}], "=", 
     RowBox[{
      RowBox[{"-", "0.5"}], "<", 
      RowBox[{"0", " ", 
       RowBox[{"(", "estable", ")"}]}]}]}]}], "*)"}]}]}], "Input",
 CellChangeTimes->{{3.9870828046918755`*^9, 3.9870828046918755`*^9}},
 CellLabel->"In[29]:=",ExpressionUUID->"4ea888cc-ad94-ea40-a029-f0b7bf0ac77a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x", "\[Rule]", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", "\[Rule]", "10"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9870828066296616`*^9, 3.9870910292574387`*^9},
 CellLabel->"Out[31]=",ExpressionUUID->"ad983921-bac2-f049-9094-3a5dce13ef67"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.5`", ",", 
   RowBox[{"-", "0.5`"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9870828066296616`*^9, 3.987091029265167*^9},
 CellLabel->"Out[33]=",ExpressionUUID->"01388b0a-8930-c545-8dff-7b9b5915d4ad"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Modelo Despensatorio", "Subsection",
 CellChangeTimes->{{3.9854143578875427`*^9, 
  3.985414366280449*^9}},ExpressionUUID->"bffbdf5e-43ed-5b46-a32e-\
44222f61b457"],

Cell[TextData[{
 "En este caso, la funci\[OAcute]n debe ser convexa cerca del origen para \
reflejar el crecimiento lento (Efecto Allee). He utilizado un t\[EAcute]rmino \
de tipo Hill ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           SuperscriptBox[
            StyleBox["x", "TI"], "2"], ")"}], "/", 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["a", "TI"], "2"], "+", 
             SuperscriptBox[
              StyleBox["x", "TI"], "2"]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "(x^2)/(a^2 + x^2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "36655935-c846-5847-87c7-3c249ab427e7"]
}], "Text",
 CellChangeTimes->{{3.985414372691288*^9, 3.98541443876614*^9}, {
  3.9870829472818775`*^9, 3.9870829591125793`*^9}, {3.987082995427143*^9, 
  3.9870830152401657`*^9}},ExpressionUUID->"851241a1-00c4-7143-874e-\
e7b6d733d68f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Modelo", " ", "con", " ", "crecimiento", " ", "inicial", " ", "lento"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Fdesp", "[", "x_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"x", "^", "2"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "^", "2"}], "+", 
          RowBox[{"x", "^", "2"}]}], ")"}]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"x", "/", "10"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"Puntos", " ", "de", " ", "equilibrio", " ", "positivos"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"equilibriosDesp", "=", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Fdesp", "[", "x", "]"}], "==", "0"}], "&&", 
       RowBox[{"x", ">=", "0"}]}], ",", "x"}], "]"}]}], "\[IndentingNewLine]",
    "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Representaci\[OAcute]n", " ", "para", " ", "ver", " ", "la", " ", 
     "convexidad", " ", "inicial"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Fdesp", "[", "x", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "10"}], "}"}], ",", 
     RowBox[{"PlotLabel", "->", "\"\<Modelo Despensatorio\>\""}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9870830420797997`*^9, 3.9870830548384953`*^9}},
 CellLabel->"In[34]:=",ExpressionUUID->"91332fd2-f450-8b47-8f03-e54812e148fd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x", "\[Rule]", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", "\[Rule]", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", "\[Rule]", "10"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9870830558375645`*^9, 3.9870910293344936`*^9},
 CellLabel->"Out[35]=",ExpressionUUID->"79a63924-2fff-e247-8839-7b5b47ce7e48"],

