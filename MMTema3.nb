Cell[CellGroupData[{

Cell["Modelo Despensatorio Cr\[IAcute]tico", "Subsection",
 CellChangeTimes->{
  3.9854144885539627`*^9},ExpressionUUID->"57ff1d52-ad6c-d544-9f61-\
690b7e27d44f"],

Cell[TextData[{
 "Este modelo es el m\[AAcute]s complejo porque la tasa de crecimiento es \
negativa para poblaciones muy peque\[NTilde]as. He definido un polinomio que \
cruza el eje en un umbral de extinci\[OAcute]n ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["x", "TI"], "3"], TraditionalForm], "errors" -> {}, "input" -> 
     "x_3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "10cee89c-efbf-3a45-ac6b-a082ddc171e9"],
 "."
}], "Text",
 CellChangeTimes->{{3.9854144737076187`*^9, 3.985414612227249*^9}, {
  3.987083136231407*^9, 
  3.987083172336397*^9}},ExpressionUUID->"9da5aeaa-fc00-1e4f-8e91-\
c3c5bd9e2295"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Par\[AAcute]metros", ":", "r"}], "=", "0.1"}], ",", 
    RowBox[{
     RowBox[{"umbral", " ", "a"}], "=", "2"}], ",", 
    RowBox[{
     RowBox[{"soporte", " ", "K"}], "=", "10"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"r", "=", "0.1"}], ";", 
    RowBox[{"a", "=", "2"}], ";", 
    RowBox[{"K", "=", "10"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Fcrit", "[", "x_", "]"}], ":=", 
     RowBox[{"r", "*", "x", "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"x", "/", "a"}], "-", "1"}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"x", "/", "K"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Puntos", " ", "de", " ", "equilibrio"}], "*)"}], "\n", 
   RowBox[{"equilibriosCrit", "=", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Fcrit", "[", "x", "]"}], "==", "0"}], ",", "x"}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", "Estabilidad", "*)"}], "\n", 
   RowBox[{
    RowBox[{"derCrit", "=", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"Fcrit", "[", "x", "]"}], ",", "x"}], "]"}]}], ";"}], "\n", 
   RowBox[{"derCrit", "/.", " ", "equilibriosCrit"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Resultados", ":", 
      RowBox[{
       RowBox[{"F", "'"}], 
       RowBox[{"(", "0", ")"}]}]}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "0.1"}], "<", 
       RowBox[{"0", " ", 
        RowBox[{"(", 
         RowBox[{"Estable", ":", 
          RowBox[{
          "tendencia", " ", "a", " ", "la", " ", "extinci\[OAcute]n"}]}], 
         ")"}], " ", 
        RowBox[{"F", "'"}], 
        RowBox[{"(", "2", ")"}]}]}], "=", 
      RowBox[{
       RowBox[{"0.08", ">", 
        RowBox[{"0", " ", 
         RowBox[{"(", 
          RowBox[{"Inestable", ":", 
           RowBox[{"umbral", " ", "cr\[IAcute]tico"}]}], ")"}], " ", 
         RowBox[{"F", "'"}], 
         RowBox[{"(", "10", ")"}]}]}], "=", 
       RowBox[{
        RowBox[{"-", "0.4"}], "<", 
        RowBox[{"0", " ", 
         RowBox[{"(", 
          RowBox[{"Estable", ":", 
           RowBox[{"poblaci\[OAcute]n", " ", "sana"}]}], ")"}]}]}]}]}]}], 
    "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.9870831757177944`*^9, 3.987083179047348*^9}},
 CellLabel->"In[37]:=",ExpressionUUID->"35a9d3b6-24c6-5d4c-b6d7-44b448b5bb86"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x", "\[Rule]", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", "\[Rule]", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", "\[Rule]", "10"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.987083179687689*^9, 3.987091029734192*^9},
 CellLabel->"Out[39]=",ExpressionUUID->"c2f4f81e-c2cf-294a-893d-fd76fef6e70c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "0.1`"}], ",", "0.08000000000000002`", ",", 
   RowBox[{"-", "0.4000000000000001`"}]}], "}"}]], "Output",
 CellChangeTimes->{3.987083179687689*^9, 3.987091029734192*^9},
 CellLabel->"Out[41]=",ExpressionUUID->"f9af2819-c954-de40-a7e8-24b55e5d6f83"]
