Cell["\<\
Primero, defino la funci\[OAcute]n de crecimiento del modelo \
log\[IAcute]stico. Para hallar su punto de m\[AAcute]ximo crecimiento, la \
derivo y hallo d\[OAcute]nde se anula.\
\>", "Text",
 CellChangeTimes->{{3.9870816804427624`*^9, 
  3.9870817330990047`*^9}},ExpressionUUID->"06d761ea-a392-3641-a49e-\
a718a227d91c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Definimos", " ", "valores", " ", "para", " ", "los", " ", 
    "par\[AAcute]metros"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"r", "=", "0.5"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"K", "=", "100"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"F", "[", "x_", "]"}], ":=", 
     RowBox[{"r", "*", "x", "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"x", "/", "K"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"F", "[", 
        RowBox[{"x", ",", "a", ",", "k"}], "]"}], ",", "x"}], "]"}], " ", "==",
      " ", "0"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9846366663872223`*^9, 3.9846366976912804`*^9}, {
  3.9870820136174526`*^9, 3.987082050907385*^9}},
