Cell[BoxData[
 TemplateBox[{
  "Plot", "plln", 
   "\"Limiting value \\!\\(\\*RowBox[{\\\"1.2`\\\", \\\" \\\", \
RowBox[{\\\"(\\\", RowBox[{\\\"e\\\", \\\"/.\\\", \\\"\[VeryThinSpace]\\\", \
RowBox[{RowBox[{\\\"{\\\", RowBox[{\\\"{\\\", RowBox[{RowBox[{\\\"x\\\", \\\"\
\[Rule]\\\", \\\"5.000000000000002`\\\"}], \\\",\\\", RowBox[{\\\"e\\\", \\\"\
