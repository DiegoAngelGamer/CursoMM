Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ludwig", "[", 
    RowBox[{"x_", ",", "r_", ",", "K_", ",", "a_", ",", " ", "b_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"r", "*", "x", "*", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"(", 
        RowBox[{"x", "/", "K"}], ")"}]}], ")"}]}], "-", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"b", "*", 
         RowBox[{"x", "^", "2"}]}], ")"}], "/", 
       RowBox[{"a", "^", "2"}]}], " ", "+", " ", 
      RowBox[{"x", "^", "2"}]}], ")"}]}]}], "\n"}], "\[IndentingNewLine]", 
