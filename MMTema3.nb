Cell[CellGroupData[{

Cell["Modelo Despensatorio Cr\[IAcute]tico", "Subsection",
 CellChangeTimes->{{3.9854141604582577`*^9, 3.985414292363537*^9}, 
   3.987087607040842*^9},ExpressionUUID->"251d12c3-95fa-cb42-837e-\
d29a3dcd138d"],

Cell["\<\
Aqu\[IAcute] solo existe el valor cr\[IAcute]tico E**. La mayor diferencia es \
que, si la poblaci\[OAcute]n se extingue por exceso de pesca, es \
irrecuperable aunque bajemos el esfuerzo, porque el origen es un equilibrio \
estable.\
\>", "Text",
 CellChangeTimes->{{3.9854142998236694`*^9, 3.9854143056686344`*^9}, {
  3.987083077785471*^9, 3.987083086910452*^9}, {3.9870875717360363`*^9, 
  3.987087596306074*^9}},ExpressionUUID->"9c31a04b-f648-8b44-a55c-\
228871d97f88"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Par\[AAcute]metros", ":", "a"}], "=", 
     RowBox[{"umbral", " ", "cr\[IAcute]tico"}]}], ",", 
    RowBox[{"K", "=", "soporte"}], ",", 
    RowBox[{"r", "=", "tasa"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"q", "=", "1"}], ";", 
    RowBox[{"r", "=", "0.1"}], ";", 
    RowBox[{"a", "=", "2"}], ";", 
    RowBox[{"K", "=", "10"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"fCrit", "[", "x_", "]"}], ":=", 
     RowBox[{"r", "*", "x", "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"x", "/", "a"}], "-", "1"}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"x", "/", "K"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Hallamos", " ", 
     RowBox[{"e", "**", 
      RowBox[{"(", 
       RowBox[{
       "punto", " ", "donde", " ", "la", " ", "recta", " ", "de", " ", 
        "pesca", " ", "es", " ", "tangente", " ", "a", " ", "la", " ", 
        "curva"}], ")"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"solCrit", "=", 
     RowBox[{
      RowBox[{"NSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"fCrit", "[", "x", "]"}], "==", 
           RowBox[{"e", "*", "x"}]}], ",", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"fCrit", "[", "x", "]"}], ",", "x"}], "]"}], "==", "e"}],
           ",", 
          RowBox[{"x", ">", "a"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "e"}], "}"}]}], "]"}], "[", 
      RowBox[{"[", "4", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"eMaxCrit", "=", 
     RowBox[{"e", "/.", " ", "solCrit"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Calculamos", " ", "el", " ", "beneficio", " ", "para", " ", "la", " ", 
     "rama", " ", "superior", " ", "estable"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"xEstableCrit", "[", "e_", "]"}], ":=", 
     RowBox[{"Max", "[", 
      RowBox[{"x", "/.", " ", 
       RowBox[{"NSolve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"fCrit", "[", "x", "]"}], "==", 
          RowBox[{"q", "*", "e", "*", "x"}]}], ",", "x"}], "]"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"beneficioCrit", "[", "e_", "]"}], ":=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"e", "<=", "eMaxCrit"}], ",", 
       RowBox[{"q", "*", "e", "*", 
        RowBox[{"xEstableCrit", "[", "e", "]"}]}], ",", "0"}], "]"}]}], ";"}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Gr\[AAcute]fica", " ", "de", " ", "la", " ", "curva", " ", "esfuerzo"}],
      "-", "beneficio"}], "*)"}], "\n", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"beneficioCrit", "[", "e", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"e", ",", "0", ",", 
       RowBox[{"eMaxCrit", "*", "1.2"}]}], "}"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<e\>\"", ",", "\"\<B\>\""}], "}"}]}], ",", 
     RowBox[{
     "PlotLabel", 
      "->", "\"\<Curva Beneficio - Modelo Despensatorio \
Cr\[IAcute]tico\>\""}], ",", 
     RowBox[{"PlotStyle", "->", "Red"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9870828046918755`*^9, 3.9870828046918755`*^9}, {
   3.9870875767716637`*^9, 3.987087580768305*^9}, {3.987087617125057*^9, 
