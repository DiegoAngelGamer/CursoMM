Cell[CellGroupData[{

Cell["Modelo Despensatorio", "Subsection",
 CellChangeTimes->{{3.9854141604582577`*^9, 3.985414292363537*^9}, 
   3.987084404394602*^9},ExpressionUUID->"48eeda5e-bd9d-174d-a705-\
8dc647a53d7f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"q", "=", "1"}], ";", 
   RowBox[{"r", "=", "0.5"}], ";", 
   RowBox[{"K", "=", "10"}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Usamos", " ", "una", " ", "forma", " ", "polin\[OAcute]mica", " ", 
    "simple", " ", "que", " ", "sea", " ", "convexa", " ", "al", " ", 
    "inicio"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"fDesp", "[", "x_", "]"}], ":=", 
    RowBox[{"r", "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"x", "^", "2"}], "/", "K"}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"x", "/", "K"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{"(*", 
   RowBox[{"Hallamos", " ", "el", " ", "esfuerzo", " ", "m\[AAcute]ximo", " ", 
    RowBox[{"e", "**", "por"}], " ", "tangencia"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"solTangencia", "=", 
   RowBox[{
    RowBox[{"NSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"fDesp", "[", "x", "]"}], "==", 
         RowBox[{"e", "*", "x"}]}], ",", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"fDesp", "[", "x", "]"}], ",", "x"}], "]"}], "==", "e"}], ",", 
        RowBox[{"x", ">", "0"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "e"}], "}"}]}], "]"}], "[", 
    RowBox[{"[", "4", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"estarStar", "=", 
    RowBox[{"e", "/.", " ", "solTangencia"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "Este", " ", "es", " ", "el", " ", "valor", " ", "de", " ", "colapso"}], 
   "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Funci\[OAcute]n", " ", "de", " ", "beneficio", " ", "B"}], "=", 
    RowBox[{"q", "*", "e", "*", "x_estable"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Buscamos", " ", "el", " ", "equilibrio", " ", "x", " ", "estable", " ", 
    RowBox[{"(", 
     RowBox[{"el", " ", "m\[AAcute]s", " ", "grande"}], ")"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"xEstable", "[", "e_", "]"}], ":=", 
   RowBox[{"Max", "[", 
    RowBox[{"x", "/.", " ", 
     RowBox[{"NSolve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"fDesp", "[", "x", "]"}], "==", 
        RowBox[{"q", "*", "e", "*", "x"}]}], ",", "x"}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"beneficio", "[", "e_", "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"e", "<=", "estarStar"}], ",", 
      RowBox[{"q", "*", "e", "*", 
       RowBox[{"xEstable", "[", "e", "]"}]}], ",", "0"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Representaci\[OAcute]n", " ", "de", " ", "la", " ", "curva", " ", 
     "esfuerzo"}], "-", "beneficio"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"beneficio", "[", "e", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"e", ",", "0", ",", 
     RowBox[{"estarStar", "*", "1.2"}]}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<e\>\"", ",", "\"\<B\>\""}], "}"}]}], ",", 
   RowBox[{
   "PlotLabel", "->", "\"\<Curva Beneficio - Modelo Despensatorio\>\""}], ",", 
   RowBox[{"PlotStyle", "->", "Orange"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9870878429093723`*^9, 3.9870878429093723`*^9}, 
   3.9870881316999855`*^9, 3.9870882570750675`*^9, 3.9870883308445377`*^9},
 CellLabel->"In[55]:=",ExpressionUUID->"70da9e5b-2465-0b48-8eb0-0320a881b744"],

