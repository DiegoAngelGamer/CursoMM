Cell[TextData[{
 "Mediante la funci\[OAcute]n DSolve, resolvemos la ecuaci\[OAcute]n en funci\
\[OAcute]n de a, b y ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["x", "TI"], "0"], TraditionalForm], "errors" -> {}, "input" -> 
     "x_0", "state" -> "Boxes"|>,
