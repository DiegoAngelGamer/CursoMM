Cell[CellGroupData[{

Cell["Ejercicio 3.10", "Section",
 CellChangeTimes->{{3.9845519872430897`*^9, 3.9845519891408367`*^9}, {
  3.984635894258362*^9, 3.9846358943736916`*^9}, {3.985068578544052*^9, 
  3.985068579519459*^9}, {3.9851557004679737`*^9, 3.985155702562065*^9}, {
  3.9870841373641148`*^9, 
  3.987084142817116*^9}},ExpressionUUID->"4d04fdc3-ba1c-bc4c-8029-\
441e6d3b2217"],

Cell[TextData[{
 "Vamos a aplicar la tasa de explotaci\[OAcute]n (pesca de arrastre) ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["h", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
         StyleBox["q", "TI"], 
         StyleBox["E", "TI"], 
         StyleBox["x", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "h(x)=qEx", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "32c185fd-dd6d-e842-aea0-5d8c1e76d69c"],
 " a cada uno de los modelos que definimos antes.\nLos puntos de equilibrio \
ahora ocurren cuando ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["F", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
         StyleBox["q", "TI"], 
         StyleBox["E", "TI"], 
         StyleBox["x", "TI"], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> "F(x)=qEx.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f8274350-69b4-fb43-8f01-47bee416188e"],
 " Para simplificar los c\[AAcute]lculos, asumiremos una tasa de \
capturabilidad q=1."
}], "Text",
 CellChangeTimes->{{3.9870841626945724`*^9, 
  3.9870841873025665`*^9}},ExpressionUUID->"eb959a92-d8b2-964f-97cd-\
95bedbbca464"],

Cell[CellGroupData[{

Cell["Modelo Compensatorio", "Subsection",
 CellChangeTimes->{{3.9854141604582577`*^9, 
  3.985414292363537*^9}},ExpressionUUID->"416832f4-7054-8147-bdd1-\
cfff76d8afa1"],

Cell["\<\
En este modelo, el esfuerzo cr\[IAcute]tico E* es el valor de la pendiente de \
la tasa de crecimiento en el origen.
Esfuerzo cr\[IAcute]tico: E* = F\[CloseCurlyQuote](0) =0,5.
Comportamiento: Si E<E*, la poblaci\[OAcute]n se estabiliza en un valor \
positivo; si E\[GreaterEqual]E*, se extingue.S\
\>", "Text",
 CellChangeTimes->{{3.9854142998236694`*^9, 3.9854143056686344`*^9}, {
  3.987083077785471*^9, 3.987083086910452*^9}, {3.98708423665308*^9, 
  3.9870843202565765`*^9}},ExpressionUUID->"20f7f7bd-4ad2-8648-a56f-\
9fce6694db0e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Definimos", " ", "el", " ", "modelo", " ", "y", " ", 
    "par\[AAcute]metros"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"r", "=", "0.5"}], ";", 
    RowBox[{"K", "=", "10"}], ";", 
    RowBox[{"q", "=", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Fcomp", "[", "x_", "]"}], ":=", 
     RowBox[{"r", "*", "x", "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"x", "/", "K"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Esfuerzo", " ", "cr\[IAcute]tico", " ", "E", "*"}], " ", "*)"}], 
   "\n", 
   RowBox[{
    RowBox[{"EstarComp", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"Fcomp", "[", "x", "]"}], ",", "x"}], "]"}], "/.", " ", 
        RowBox[{"x", "->", "0"}]}], ")"}], "/", "q"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Da", " ", "0.5"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Equilibrio", " ", "estable", " ", "x2", " ", "para", " ", "E"}],
      "<", 
     RowBox[{"E", "*"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"x2Comp", "[", "e_", "]"}], ":=", 
     RowBox[{"K", "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"q", "*", "e"}], ")"}], "/", "r"}]}], ")"}]}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Curva", " ", "de", " ", "beneficio"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Bcomp", "[", "e_", "]"}], ":=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"e", "<", "EstarComp"}], ",", 
       RowBox[{"q", "*", "e", "*", 
        RowBox[{"x2Comp", "[", "e", "]"}]}], ",", "0"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Bcomp", "[", "e", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"e", ",", "0", ",", "0.7"}], "}"}], ",", 
     RowBox[{"PlotLabel", "->", "\"\<Beneficio: Modelo Compensatorio\>\""}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<E\>\"", ",", "\"\<B\>\""}], "}"}]}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.987084336927986*^9, 3.9870843715651913`*^9}, {
  3.98708802664419*^9, 3.987088053322439*^9}, {3.987088099782036*^9, 
  3.9870881121736393`*^9}},
 CellLabel->"In[49]:=",ExpressionUUID->"17bcb809-fd41-4443-800e-12c589c330a3"],

