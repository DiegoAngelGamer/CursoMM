Cell[TextData[{
 "Para determinar los puntos de equilibrio, debemos hallar los puntos de \
corte entre las dos funciones ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Alpha]", ",", "\[Beta]"}], TraditionalForm], "errors" -> {},
      "input" -> "\\alpha, \\beta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e0627bd6-a6b7-6d46-b5ec-fcbb5a5bdc8a"],
 "; es decir, hallar los ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["x", "TI"], "\[Element]", 
         StyleBox["R", FontSlant -> "Plain"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "x \\in \\mathbb{R}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2d5af6b6-014a-4042-9435-4bd7ee3935a8"],
 " tales que ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Alpha]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", "\[Beta]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\alpha(x) = \\beta(x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "47c7e331-289f-114d-8b48-a3940f77b662"],
 ".\nPrimero, tenemos que ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["s", "TI"], 
         RowBox[{"(", 
           RowBox[{"1", "-", 
             FractionBox[
              StyleBox["u", "TI"], 
              StyleBox["q", "TI"]]}], ")"}], "\[LongEqual]", 
         FractionBox[
          StyleBox["u", "TI"], 
          RowBox[{"1", "+", 
            SuperscriptBox[
             StyleBox["u", "TI"], "2"]}]]}], TraditionalForm], "errors" -> {},
      "input" -> "s\\left(1 - \\frac{u}{q}\\right) = \\frac{u}{1 + u^2}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4efa554a-b350-584d-8aa3-d7cf73b5da4e"],
 ", esto es, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["s", "TI"], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SuperscriptBox[
              StyleBox["u", "TI"], "2"], "-", 
             FractionBox[
              StyleBox["u", "TI"], 
              StyleBox["q", "TI"]], "-", 
             FractionBox[
              SuperscriptBox[
               StyleBox["u", "TI"], "3"], 
              StyleBox["q", "TI"]]}], ")"}], "\[LongEqual]", 
         StyleBox["u", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "s \\left( 1 + u^2 - \\frac{u}{q} - \\frac{u^3}{q} \\right) = u", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0646bd16-de5a-0d4d-a331-4fc8ca7ab737"],
 ". Desarrollamos para obtener el polinomio de tercer grado: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["s", "TI"], "-", 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             FractionBox[
              StyleBox["s", "TI"], 
              StyleBox["q", "TI"]]}], ")"}], 
         StyleBox["u", "TI"], "+", 
         StyleBox["s", "TI"], 
         SuperscriptBox[
          StyleBox["u", "TI"], "2"], "-", 
         FractionBox[
          StyleBox["s", "TI"], 
          StyleBox["q", "TI"]], 
         SuperscriptBox[
          StyleBox["u", "TI"], "3"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "s - \\left(1 + \\frac{s}{q}\\right)u + s u^2 - \\frac{s}{q}u^3 = 0", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9d4193ea-32e1-094e-88b6-8f656d364e78"],
 ". Los puntos de equilibrio vienen dados por la soluci\[OAcute]n anal\
\[IAcute]tica a la ecuaci\[OAcute]n.\nAhora, para determinar un par ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{
           StyleBox["q", "TI"], ",", 
           StyleBox["s", "TI"]}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "(q,s)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d1c8a812-8d09-324c-ad09-27e651caeddd"],
 " para el cual existen dos puntos de equilibrio, fijamos ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["q", "TI"], "\[LongEqual]", "7"}], TraditionalForm], 
     "errors" -> {}, "input" -> "q = 7", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bd9cbe49-7be2-fb45-b221-e82770cb65f8"],
 ". Sabemos que las gr\[AAcute]ficas deben de ser tangentes, adem\[AAcute]s \
de cortarse.\nCalculamos las derivadas respecto a ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["u", "TI"], TraditionalForm], "errors" -> {}, "input" -> "u", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0ebd040c-7a81-2b44-9053-53a530f2e53c"],
 ":\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Alpha]", "\[Prime]"], 
         RowBox[{"(", 
           StyleBox["u", "TI"], ")"}], "\[LongEqual]", "-", 
         FractionBox[
          StyleBox["s", "TI"], "7"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\alpha'(u) = -\\frac{s}{7}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "065fbc36-5dc3-b14a-87a8-0033a0d29cfc"],
 ",\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Beta]", "\[Prime]"], 
         RowBox[{"(", 
           StyleBox["u", "TI"], ")"}], "\[LongEqual]", 
         FractionBox[
          RowBox[{"1", "\[CenterDot]", 
            RowBox[{"(", 
              RowBox[{"1", "+", 
                SuperscriptBox[
                 StyleBox["u", "TI"], "2"]}], ")"}], "-", 
            StyleBox["u", "TI"], "\[CenterDot]", 
            RowBox[{"(", 
              RowBox[{"2", 
                StyleBox["u", "TI"]}], ")"}]}], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"1", "+", 
               SuperscriptBox[
                StyleBox["u", "TI"], "2"]}], ")"}], "2"]], "\[LongEqual]", 
         FractionBox[
          RowBox[{"1", "-", 
            SuperscriptBox[
             StyleBox["u", "TI"], "2"]}], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"1", "+", 
               SuperscriptBox[
                StyleBox["u", "TI"], "2"]}], ")"}], "2"]]}], TraditionalForm],
      "errors" -> {}, "input" -> 
     "\\beta'(u) = \\frac{1 \\cdot (1+u^2) - u \\cdot (2u)}{(1+u^2)^2} = \
\\frac{1-u^2}{(1+u^2)^2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c39e1244-039e-a349-9fef-ab390d0ce951"],
 "."
}], "Text",
 CellChangeTimes->{{3.985229028045801*^9, 3.9852293106611347`*^9}, {
   3.985229340815777*^9, 3.985229340815777*^9}, {3.9852294047405796`*^9, 
