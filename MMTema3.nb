Cell[CellGroupData[{

Cell["Ejercicio 3.16", "Section",
 CellChangeTimes->{{3.9845519872430897`*^9, 3.9845519891408367`*^9}, {
  3.984635894258362*^9, 3.9846358943736916`*^9}, {3.985068578544052*^9, 
  3.985068579519459*^9}, {3.9851557004679737`*^9, 3.985155702562065*^9}, {
  3.9851573488081837`*^9, 3.985157348939436*^9}, {3.9870895824790154`*^9, 
  3.9870895828228436`*^9}, {3.9870898512822266`*^9, 
  3.987089851876322*^9}},ExpressionUUID->"b3a55c7e-fd01-184d-b488-\
6dbdc64b3d9f"],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"c", ",", "q", ",", "s", ",", "u"}], "]"}]], "Input",
 CellChangeTimes->{{3.9870910470934772`*^9, 3.987091057808243*^9}},
 CellLabel->
  "In[110]:=",ExpressionUUID->"6aa744fd-39de-184b-a6ef-77f6448da10f"],

Cell[TextData[{
 "Vamos a localizar el punto singular (c\[UAcute]spide) del espacio de par\
\[AAcute]metros y el punto de inflexi\[OAcute]n de la funci\[OAcute]n de \
depredaci\[OAcute]n \[Beta](u).\nLa curva de bifurcaci\[OAcute]n, que marca \
los puntos donde el modelo de Ludwig tiene equilibrios por tangencia, est\
\[AAcute] parametrizada por c>1 como\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["q", "TI"], 
         RowBox[{"(", 
           StyleBox["c", "TI"], ")"}], "\[LongEqual]", 
         FractionBox[
          RowBox[{"2", 
            SuperscriptBox[
             StyleBox["c", "TI"], "3"]}], 
          RowBox[{
            SuperscriptBox[
             StyleBox["c", "TI"], "2"], "-", "1"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> "q(c) = \\frac{2c^3}{c^2 - 1}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "22767bcc-c999-774e-a37d-fdd76f03c780"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["s", "TI"], 
         RowBox[{"(", 
           StyleBox["c", "TI"], ")"}], "\[LongEqual]", 
         FractionBox[
          RowBox[{"2", 
            SuperscriptBox[
             StyleBox["c", "TI"], "3"]}], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"1", "+", 
               SuperscriptBox[
                StyleBox["c", "TI"], "2"]}], ")"}], "2"]]}], TraditionalForm],
      "errors" -> {}, "input" -> "s(c) = \\frac{2c^3}{(1+c^2)^2}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5f16dbe7-ea0a-144a-adb9-8c856c9ed67e"],
 "\nPara hallar la c\[UAcute]spide P=(",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["q", "TI"], "_"], ",", 
         OverscriptBox[
          StyleBox["s", "TI"], "_"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\overline{q},\\overline{s}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f0bd4d5e-0ed1-0a45-9b59-30c0984a4363"],
 "), debemos encontrar el valor de c que anula las primeras derivadas de \
ambas funciones."
}], "Text",
 CellChangeTimes->{{3.9870898758505383`*^9, 3.9870899001304626`*^9}, {
  3.987089985816065*^9, 3.987089988281019*^9}, {3.987090059572563*^9, 
  3.9870900605593433`*^9}, {3.987090100932516*^9, 3.9870901068080673`*^9}, {
  3.9870901507188873`*^9, 
  3.9870901563895683`*^9}},ExpressionUUID->"668c82b3-0230-b847-b8d0-\
d1b95324fad8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Definimos", " ", "las", " ", "funciones", " ", "de", " ", "la", " ", 
    "curva", " ", "de", " ", "tangencia"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"q", "[", "c_", "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"2", "*", 
       RowBox[{"c", "^", "3"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"c", "^", "2"}], "-", "1"}], ")"}]}]}], "\n", 
   RowBox[{
    RowBox[{"s", "[", "c_", "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"2", "*", 
       RowBox[{"c", "^", "3"}]}], ")"}], "/", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"c", "^", "2"}]}], ")"}], "^", "2"}]}]}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "1.", " ", "Hallamos", " ", "el", " ", "valor", " ", "de", " ", "c", " ", 
     "para", " ", "el", " ", "punto", " ", "de", " ", "c\[UAcute]spide"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Resolvemos", " ", 
      RowBox[{"dq", "/", "dc"}]}], "=", 
     RowBox[{
      RowBox[{"0", " ", "para", " ", "c"}], ">", "1"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"solC", "=", 
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"q", "[", "c", "]"}], ",", "c"}], "]"}], "==", "0"}], "&&", 
        RowBox[{"c", ">", "1"}]}], ",", "c"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"valorC", "=", 
     RowBox[{"c", "/.", " ", "solC"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Esto", " ", "nos", " ", "devuelve", " ", 
     RowBox[{"Sqrt", "[", "3", "]"}]}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Calculamos", " ", "las", " ", "coordenadas", " ", "del", " ", "punto", " ",
      "P"}], "*)"}], "\n", 
   RowBox[{"puntoP", "=", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"q", "[", "valorC", "]"}], ",", 
       RowBox[{"s", "[", "valorC", "]"}]}], "}"}], "//", "Simplify"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"El", " ", "resultado", " ", "es", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"3", "*", 
        RowBox[{"Sqrt", "[", "3", "]"}]}], ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"3", "*", 
          RowBox[{"Sqrt", "[", "3", "]"}]}], ")"}], "/", "8"}]}], "}"}]}], 
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "Calculamos", " ", "el", " ", "punto", " ", "de", " ", 
     "inflexi\[OAcute]n", " ", "de", " ", "beta", 
     RowBox[{"(", "u", ")"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"beta", "[", "u_", "]"}], ":=", 
    RowBox[{"u", "/", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"u", "^", "2"}]}], ")"}]}]}], "\n", 
   RowBox[{
    RowBox[{"segundaDer", "=", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"beta", "[", "u", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"u", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"puntoInflexion", "=", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"segundaDer", "==", "0"}], "&&", 
       RowBox[{"u", ">", "0"}]}], ",", "u"}], "]"}]}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"El", " ", "resultado", " ", "es", " ", "u"}], "->", 
     RowBox[{"Sqrt", "[", "3", "]"}]}], "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.987090171390808*^9, 3.9870901789348087`*^9}, {
   3.9870902842098427`*^9, 3.987090305538393*^9}, 3.987091020158596*^9, {
   3.9870910677970715`*^9, 3.9870911041370316`*^9}},
 CellLabel->
  "In[127]:=",ExpressionUUID->"2fb180f3-7479-df4c-af24-b647d25c55e5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"3", " ", 
     SqrtBox["3"]}], "}"}], ",", 
   RowBox[{"{", 
    FractionBox[
     RowBox[{"3", " ", 
      SqrtBox["3"]}], "8"], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{{3.9870901732322807`*^9, 3.987090187536501*^9}, 
   3.987090288628195*^9, 3.987090393007572*^9, {3.987090996728422*^9, 
   3.9870910899623394`*^9}, 3.9870912689089184`*^9},
 CellLabel->
  "Out[131]=",ExpressionUUID->"af146fbb-d8fa-434b-9dd0-948a43259490"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"u", "\[Rule]", 
    SqrtBox["3"]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{{3.9870901732322807`*^9, 3.987090187536501*^9}, 
   3.987090288628195*^9, 3.987090393007572*^9, {3.987090996728422*^9, 
   3.9870910899623394`*^9}, 3.987091268915552*^9},
 CellLabel->
  "Out[134]=",ExpressionUUID->"f451014f-5ed7-bc49-a7d8-a35914054577"]
}, Open  ]]
