              RowBox[{"Red", ",", 
               RowBox[{"PointSize", "[", "Large", "]"}], ",", 
               RowBox[{"Point", "[", 
                RowBox[{"{", 
                 RowBox[{"e", ",", "b"}], "}"}], "]"}]}], "}"}]}]}], "]"}]}], 
         "}"}], ",", 
        RowBox[{"ImageSize", "->", "700"}]}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
